# OCPP 1.6-J WebSocket URL des Backends (z.B. PUMP connect, Monta, etc.)
OCPP_BACKEND_URL=wss://ocpp.800volt.de/1.6J/id/ihre-chargebox-id

# Lokale REST-API Adresse von evcc
EVCC_API_URL=http://127.0.0.1:7070

# Index des Ladepunkts in evcc (1 = erster Ladepunkt)
EVCC_LOADPOINT_ID=1

# Intervall für periodische Zählerstandsmeldungen in Sekunden
METER_INTERVAL=60
